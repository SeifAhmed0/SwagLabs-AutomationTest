
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SwagLabsAutomation">

    <parameter name="webAppURL" value="https://www.saucedemo.com/"/>

    <test name="Login" enabled="true">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>
    <test name="Login" enabled="false">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>
    <test name="Login" enabled="false">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>


    <test name="Inventory" enabled="true">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>
    <test name="Inventory" enabled="false">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>
    <test name="Inventory" enabled="false">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>
</suite>
